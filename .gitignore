# macOS
.DS_Store

# Build output (SwiftPM, xcodebuild derived data, script products)
.build/
DerivedData/
*.xcresult

# Machine-specific signing settings
Config/Local.xcconfig

# The Xcode project is generated by XcodeGen (`xcodegen generate`)...
*.xcodeproj/*
# ...except the resolved package versions, which are kept for reproducible builds.
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Xcode user state
xcuserdata/
*.xcuserstate

# Local package resolution of LLMCore when built standalone
Packages/LLMCore/Package.resolved
Packages/LLMCore/.swiftpm/
