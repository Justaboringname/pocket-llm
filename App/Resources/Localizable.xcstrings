      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "思考中…"
          }
        }
      }
    },
    "This downloads %@ from huggingface.co. Keep the app open until it finishes: downloads pause in the background. Wi-Fi recommended.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从 huggingface.co 下载 %@。下载完成前请让 App 保持在前台，切到后台会暂停下载。建议使用 Wi-Fi。"
          }
        }
      }
    },
    "This frees %@. You can download it again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将释放 %@，以后可以重新下载。"
          }
        }
      }
    },
    "Thought for %@ s": {
      "comment": "Collapsed thinking block, e.g. \"Thought for 3.2 s\".",
      "localizations": {
