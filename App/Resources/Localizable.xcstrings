{
  "sourceLanguage": "en",
  "strings": {
    "%@ could not be loaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载 %@。"
          }
        }
      }
    },
    "%@ needs about %@ of free storage, but only %@ is available. Free up space in Settings › General › iPhone Storage and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 需要约 %2$@ 可用空间，但目前只有 %3$@。请在“设置 › 通用 › iPhone 储存空间”中清理后重试。"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ parameters, %@, %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 参数，%2$@，%3$@"
          }
        }
      }
    },
    "%@ tok/s": {
      "comment": "Decode speed in the message footer, e.g. \"42.1 tok/s\". Keep \"tok/s\".",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tok/s"
          }
        }
      }
    },
    "%lld tokens": {
      "comment": "Number of generated tokens in the message footer.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld token"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld tokens"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个 token"
          }
        }
      }
    },
    "AI-generated content": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 生成的内容"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "致谢"
          }
        }
      }
    },
    "Active": {
      "comment": "Model card: this model is the one in use.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中"
          }
        }
      }
    },
    "All models": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部模型"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancel download": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消下载"
          }
        }
      }
    },
    "Changes apply to the next reply. Defaults come from each model's recommended settings; longer replies use more memory.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改从下一条回复起生效。默认值来自各模型的推荐设置；回复越长，占用内存越多。"
          }
        }
      }
    },
    "Chat with a language model that runs entirely on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和一个完全在这台 iPhone 上运行的语言模型聊天。"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
    "Choose a model to start": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个模型即可开始"
          }
        }
      }
    },
    "Choose model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择模型"
