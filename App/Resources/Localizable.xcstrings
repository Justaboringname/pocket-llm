    "Thermal state": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度状态"
          }
        }
      }
    },
    "Thinking": {
      "comment": "Toggle and badge for the model's reasoning (\"thinking\") mode.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "思考"
          }
        }
      }
