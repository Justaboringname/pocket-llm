    "Download a model to start": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载一个模型即可开始"
          }
        }
      }
    },
    "Download progress": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载进度"
          }
        }
      }
    },
    "Download · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载 · %@"
          }
        }
      }
    },
    "Downloads pause if you leave the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开 App 后，下载会暂停。"
          }
        }
      }
    },
    "Engine": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推理引擎"
          }
        }
      }
    },
    "Expanded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已展开"
          }
        }
      }
    },
    "Explain how a language model picks its next word, in plain terms.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用大白话讲讲：语言模型是怎么选出下一个词的？"
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败"
          }
        }
      }
    },
    "Fits": {
      "comment": "Badge: the model fits in memory.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存够用"
          }
        }
      }
    },
    "Fits, with little room to spare. iOS may close the app if other apps need memory.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以运行，但余量很小。其他 App 需要内存时，iOS 可能会关闭本 App。"
          }
        }
      }
    },
    "From huggingface.co. Keep the app open while it downloads.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 huggingface.co 下载。下载期间请让 App 保持在前台。"
          }
        }
      }
    },
    "Generation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成"
          }
        }
      }
    },
    "Generation paused: device too hot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备过热，已暂停生成"
          }
        }
      }
    },
    "Give me three ideas for a quick weeknight dinner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给我三个下班后能快速做好的晚饭点子。"
          }
        }
      }
    },
    "Hardware model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件型号"
          }
        }
      }
    },
    "Hot": {
      "comment": "Thermal chip in the live readout when the device is hot (serious thermal state).",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发热"
          }
        }
      }
    },
    "Increased memory limit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高内存上限"
          }
        }
      }
    },
    "Jump to latest": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到最新"
          }
        }
      }
    },
    "Length limit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达长度上限"
          }
        }
      }
    },
    "Length limit while thinking": {
      "comment": "Message footer marker: the reply reached its token limit while the model was still in its thinking block, so there is no answer.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "思考时已达长度上限"
          }
        }
      }
    },
    "License: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许可证：%@"
          }
        }
      }
    },
    "Load": {
      "comment": "Model card button: load the selected (unloaded) model again.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载"
          }
        }
      }
    },
    "Loading %@…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载 %@…"
          }
        }
      }
    },
    "MLX on the GPU": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX（GPU）"
          }
        }
      }
    },
    "Max response tokens": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次回复 token 上限"
          }
        }
      }
    },
    "Memory in use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已用内存"
          }
        }
      }
    },
    "Memory limit for this app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 内存上限"
          }
        }
      }
    },
    "Message": {
      "comment": "Placeholder of the message field.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入消息"
          }
        }
      }
    },
    "Model files are downloaded from huggingface.co only when you tap Download.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你轻点“下载”后，才会从 huggingface.co 下载模型文件。"
          }
        }
      }
    },
    "Model licenses": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型许可证"
          }
        }
      }
    },
    "Model weights are published by their authors under these licenses and are downloaded only when you ask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型权重由作者按以上许可证发布，只在你要求时才下载。"
          }
        }
      }
    },
    "Model: %@, failed to load": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型：%@，加载失败"
          }
        }
      }
    },
    "Model: %@, loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型：%@，正在加载"
          }
        }
      }
    },
    "Model: %@, loads when you send": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型：%@，发送时加载"
          }
        }
      }
    },
    "Model: %@, ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型：%@，已就绪"
          }
        }
      }
    },
    "Models": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "Models run entirely on this device. There are no accounts, no analytics and no data collection, and nothing you type is sent to a server. Your conversation is stored only on this iPhone (and, like other app data, in your own iCloud or computer backup). The only network use is downloading model files from huggingface.co when you ask for it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型完全在这台设备上运行。没有账户、没有统计分析，也不收集任何数据，你输入的内容不会发送到任何服务器。对话只保存在这台 iPhone 上（和其他 App 数据一样，也会进入你自己的 iCloud 或电脑备份）。唯一的联网操作，是在你要求时从 huggingface.co 下载模型文件。"
          }
        }
      }
    },
    "Models run on this iPhone's GPU. Larger ones answer better but need more memory and are slower.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型在这台 iPhone 的 GPU 上运行。越大的模型回答越好，但也更占内存、更慢。"
          }
        }
      }
    },
    "Models use %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型占用 %@"
          }
        }
      }
    },
    "Models use %@ · %@ free on this iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型占用 %1$@ · 本机可用 %2$@"
          }
        }
      }
    },
    "New conversation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新对话"
          }
        }
      }
    },
    "No model on this iPhone yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上还没有模型。"
