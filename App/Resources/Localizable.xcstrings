      }
    },
    "Device is hot; replies may slow down": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备发热，回复可能变慢"
          }
        }
      }
    },
    "Dismiss": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
